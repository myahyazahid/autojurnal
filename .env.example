# ============================================================================
#  AutoJurnal — konfigurasi. Salin ke ".env" (file .env TIDAK masuk git).
# ============================================================================

# Alamat publik aplikasi (tanpa garis miring di akhir).
#   Laptop : http://127.0.0.1:8000
#   VPS    : https://autojurnal.kampus.ac.id
AUTOJURNAL_BASE_URL=http://127.0.0.1:8000

# Kunci rahasia untuk menandatangani cookie sesi. Isi string acak panjang, mis. hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kosong = dibuat otomatis & disimpan di data/.secret_key
AUTOJURNAL_SECRET_KEY=

# Cookie hanya lewat HTTPS. Otomatis "true" bila BASE_URL diawali https://
AUTOJURNAL_COOKIE_AMAN=

# Email yang otomatis menjadi ADMIN (pisahkan dengan koma).
# Bila kosong, akun PERTAMA yang mendaftar/masuk menjadi admin.
AUTOJURNAL_ADMIN_EMAILS=

# Boleh daftar sendiri (email+sandi atau Google pertama kali)? false = hanya admin yang menambahkan.
AUTOJURNAL_IZINKAN_DAFTAR=true

# Batasi domain email (pisahkan koma), mis. gmail.com,unusa.ac.id. Kosong = semua domain.
AUTOJURNAL_DOMAIN_EMAIL=

# Lama sesi login (hari)
AUTOJURNAL_LAMA_SESI_HARI=14

# ---------------------------------------------------------------------------
#  Login dengan Google (OAuth 2.0)
#  1. https://console.cloud.google.com/ → buat/ pilih project
#  2. APIs & Services → OAuth consent screen → External → isi nama app & email
#  3. APIs & Services → Credentials → Create credentials → OAuth client ID
#     Application type: Web application
#     Authorized redirect URIs:
#       http://127.0.0.1:8000/api/auth/google/callback          (laptop)
#       https://autojurnal.kampus.ac.id/api/auth/google/callback (VPS)
#  4. Salin Client ID & Client secret ke bawah ini, lalu restart aplikasi.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kosong = {AUTOJURNAL_BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
#  Lain-lain (opsional)
# ---------------------------------------------------------------------------
# AUTOJURNAL_DATA=/var/lib/autojurnal
# AUTOJURNAL_DB=sqlite:////var/lib/autojurnal/autojurnal.db
# AUTOJURNAL_MAKS_MB=50
