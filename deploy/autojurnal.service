# Contoh layanan systemd — salin ke /etc/systemd/system/autojurnal.service
# GANTI: namauser (user pemilik folder clone) dan /home/namauser/autojurnal (lokasi clone). Port 8010 boleh diganti.
[Unit]
Description=AutoJurnal - cek naskah artikel otomatis
After=network.target

[Service]
User=namauser
WorkingDirectory=/home/namauser/autojurnal/backend
ExecStart=/home/namauser/autojurnal/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
